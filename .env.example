# telegram
BOT_TOKEN=
OWNER_ID=
ALERT_CHAT_ID=

# public endpoint behind the HAProxy (no trailing slash)
PUBLIC_BASE=https://pay.example.com

# nowpayments (api keys page + ipn secret)
NOWPAYMENTS_KEY=
NOWPAYMENTS_IPN_SECRET=

# money
MIN_USD=4
MAX_USD=10000
GRACE_MINUTES=10
TOLERANCE_PCT=0.99
TOLERANCE_ABS=0.50

# branding: name on the bot and the page, logo path under web/, theme colours
BRAND_NAME=PAY
BRAND_LOGO=icons/logo.svg
BRAND_ACCENT=#c8102e
BRAND_ACCENT2=#ff2b3d
BRAND_BG=#000000
BRAND_TEXT=#e8e5df

# housekeeping
DB_PATH=/data/payram.db
TZ=Asia/Kolkata
PORT=8090
